{
  "kind": "business_state",
  "version": "0.1.0",
  "title": "Business State",
  "description": "Persist correlated records with optimistic revisions, explicit transitions and a bounded event journal.",
  "repository_url": "https://github.com/HackInvent/bloxmith-business-state",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "prerequisites": [],
  "locales": {
    "en": "locales/en.json",
    "fr": "locales/fr.json"
  },
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "event",
        "title": "event",
        "accepts": [
          "application/json",
          "text/plain",
          "file/path",
          "message/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution"
      },
      {
        "id": 2,
        "name": "query",
        "title": "query",
        "accepts": [
          "application/json",
          "text/plain",
          "file/path",
          "message/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "state",
        "title": "state",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 2,
        "name": "events",
        "title": "events",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 3,
        "name": "conflicts",
        "title": "conflicts",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      }
    ]
  },
  "config": {
    "namespace": "default",
    "initial_state": "pending",
    "transitions": {
      "pending": [
        "approved",
        "cancelled"
      ],
      "approved": [
        "running",
        "cancelled"
      ],
      "running": [
        "completed",
        "failed",
        "cancelled"
      ],
      "failed": [
        "pending"
      ],
      "completed": [],
      "cancelled": []
    },
    "max_records": 1000,
    "max_journal": 10000,
    "max_dedup": 20000,
    "retention_sec": 604800,
    "max_bytes": 131072
  },
  "port_capabilities": {
    "can_add_inputs": false,
    "can_add_outputs": false
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "any_event",
    "file_browser": false,
    "active_execution_policy": "on_each_event"
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/inspector_panel.js"
      }
    ],
    "node_card": [
      {
        "kind": "css",
        "path": "assets/css/node_card.css"
      }
    ]
  }
}
